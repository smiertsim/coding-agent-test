# GitLab API Token (required)
# You can create a personal access token at: https://gitlab.com/-/profile/personal_access_tokens
# or your GitLab instance at: YOUR_GITLAB_URL/-/profile/personal_access_tokens
GITLAB_TOKEN=your_gitlab_token_here

# GitLab Base URL (optional, defaults to https://gitlab.com)
# For self-hosted GitLab instances, set this to your GitLab URL
GITLAB_BASE_URL=https://gitlab.com

# Default Project ID (optional)
# If set, this project will be used when no projectId is specified in tool calls
# Can be either the project ID (number) or the project path (namespace/project-name)
GITLAB_PROJECT_ID=