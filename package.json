{
  "name": "coding-agent-test",
  "version": "1.0.0",
  "description": "This is going to hold a set of mcp servers that can be used in mcp clients like claude desktop",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "setup": "node setup.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "keywords": ["mcp", "gitlab", "context", "server"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@gitbeaker/rest": "^42.5.0",
    "@modelcontextprotocol/sdk": "^1.15.0",
    "@types/node": "^24.0.10",
    "dotenv": "^17.1.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@typescript-eslint/eslint-plugin": "^8.36.0",
    "@typescript-eslint/parser": "^8.36.0",
    "eslint": "^9.30.1",
    "prettier": "^3.6.2"
  }
}
